# Diretorio onde a sessao autenticada do Baileys sera salva (multi-file auth state)
WHATSAPP_SESSION_DIR=./auth_session

# Numero (com DDI/DDD, so digitos) que recebe as ofertas para aprovacao manual.
# Formato: 55DDDNUMERO, ex: 5511999998888
APPROVAL_NUMBER=

# ID do grupo do WhatsApp onde as ofertas aprovadas serao postadas.
# Formato: xxxxxxxxxx-xxxxxxxxxx@g.us (obtido nos logs do bot apos ele listar os grupos)
GROUP_ID=

# Intervalo (em minutos) entre execucoes do coletor
COLLECTOR_INTERVAL_MINUTES=20

# Caminho do arquivo do banco de dados SQLite
DB_PATH=./data/ofertas.db

# Nivel de log (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# --- IDs de afiliado (usados a partir da Etapa 6) ---
AMAZON_AFFILIATE_TAG=
